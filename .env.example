# متغيرات البيئة لأداة فحص أمان المواقع
# انسخ هذا الملف إلى .env وعدّل القيم

# الرمز السري الرئيسي (يجب أن يكون قويًا وطويلًا)
SCANNER_SECRET=your-very-strong-secret-key-change-this-in-production-32-characters-minimum

# مفتاح API للمصادقة (استخدم عشوائية قوية)
SCANNER_API_KEY=sk_live_premium_scanner_access_token_2026

# نمط التصحيح (True أو False)
SCANNER_DEBUG=False

# مستوى التسجيل (DEBUG, INFO, WARNING, ERROR)
SCANNER_LOG_LEVEL=INFO

# المهلة الزمنية للفحوصات (بالثواني)
SCANNER_TIMEOUT=5

# عدد محاولات الفحص الأقصى
SCANNER_MAX_RETRIES=3

# حد السرعة (عدد الفحوصات في الدقيقة)
SCANNER_RATE_LIMIT=10

# قاعدة البيانات (اختياري)
DATABASE_URL=sqlite:///scanner.db

# البريد الإلكتروني للإشعارات (اختياري)
NOTIFICATION_EMAIL=admin@example.com

# مسار حفظ التقارير
REPORT_OUTPUT_DIR=./reports

# تفعيل سجلات الوصول
ENABLE_ACCESS_LOGS=True